<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <PackageId>DeftSharp.Windows.Input</PackageId>
        <Authors>DeftSharp</Authors>
        <Company>DeftSharp</Company>
        <Product>DeftSharp.Windows.Input</Product>
        <RootNamespace>DeftSharp.Windows.Input</RootNamespace>
        <AssemblyName>DeftSharp.Windows.Input</AssemblyName>
        <Title>DeftSharp.Windows.Input</Title>
        <Description>An open-source .NET library designed for keyboard and mouse control in Windows.</Description>
        <Copyright>Copyright (c) 2024 Oleg Dubovoi</Copyright>
        <PackageProjectUrl>https://github.com/Empiree/DeftSharp.Windows.Input</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Empiree/DeftSharp.Windows.Input</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>WPF WinUI WinUI3 MAUI Avalonia Windows WinAPI Input Keyboard Mouse Keyboard-Listener Mouse-Listener Hook Hotkey</PackageTags>
        <Version>0.11</Version>
        <PackageIcon>DeftSharp-icon.png</PackageIcon>
        <PackageReleaseNotes>https://github.com/Empiree/DeftSharp.Windows.Input/releases/tag/v0.11</PackageReleaseNotes>
        <LangVersion>12</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <None Update="DeftSharp-icon.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="DeftSharp.Windows.Input.Tests" />
    </ItemGroup>

</Project>
